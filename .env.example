# ---------------------------------------------------------------------------
# Task Flow backend — environment variables
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000

# SQLite database file. The path is resolved relative to the `prisma/` folder.
# Use `file:./dev.db` locally and `file:./test.db` for the test suite.
DATABASE_URL="file:./dev.db"

# Authentication
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS: comma separated list of allowed origins, or * for all (dev only).
CORS_ORIGIN=*

# Rate limiting (seconds / max requests) applied to auth endpoints.
THROTTLE_TTL=60
THROTTLE_LIMIT=10
